{
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/r.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "installCommand": "npm install --omit=dev"
}
